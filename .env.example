# Environment Configuration for Smart CCTV System

# Telegram Bot Credentials
BOT_TOKEN=YOUR_BOT_TOKEN
CHAT_ID=YOUR_CHAT_ID

# MQTT Configuration
MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_TOPIC=emqx/esp32

# Model Path (defaults to best_float32.tflite in current directory if empty)
MODEL_PATH=best_float32.tflite
